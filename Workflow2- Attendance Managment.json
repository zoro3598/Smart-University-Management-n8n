      "parameters": {
        "jsCode": "const rows = items; // all attendance rows for this student\nconst total = rows.length;\nconst present = rows.filter(item => item.json.Status === \"Present\").length;\nconst percentage = total > 0 ? Math.round((present / total) * 100) : 0;\n\nreturn [{\n  json: {\n    roll_no: rows[0]?.json.Roll_No || \"\",\n    student_name: rows[0]?.json.Student_Name || \"\",\n    total_classes: total,\n    present_count: present,\n    attendance_percent: percentage\n  }\n}];"
      },
